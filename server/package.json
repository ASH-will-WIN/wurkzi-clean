{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:deploy": "node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "postinstall": "npm run prisma:generate",
    "prestart": "npm run prisma:generate",
    "start": "node index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "prisma": "^5.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^13.0.0",
    "twilio": "^5.10.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
